{
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios", "questions", "assumptions"],
  "properties": {
    "scenarios": {
      "type": "array",
      "description": "At most 10 unapproved scenario drafts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "expected_outcome", "steps"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "expected_outcome": {"type": "string"},
          "steps": {
            "type": "array",
            "description": "Between 1 and 50 steps, including at least one assertion.",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "path", "test_id", "value", "secret_env"],
              "properties": {
                "action": {"type": "string", "enum": ["navigate", "fill", "click", "assert_text", "assert_visible"]},
                "path": {"type": ["string", "null"]},
                "test_id": {"type": ["string", "null"]},
                "value": {"type": ["string", "null"]},
                "secret_env": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "questions": {"type": "array", "description": "At most 20 focused questions, each at most 4000 characters.", "items": {"type": "string"}},
    "assumptions": {"type": "array", "description": "At most 20 assumptions, each at most 4000 characters.", "items": {"type": "string"}}
  }
}
