{
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios", "questions", "assumptions"],
  "properties": {
    "scenarios": {
      "type": "array",
      "description": "At most 10 unapproved scenario drafts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "expected_outcome", "steps"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "expected_outcome": {"type": "string"},
          "steps": {
            "type": "array",
            "description": "Up to 50 steps for checks, or up to 200 ordered steps for a complete journey. Include assertions.",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "path", "test_id", "value", "secret_env", "locator", "save_as", "json_pointer", "value_ref"],
              "properties": {
                "action": {"type": "string", "enum": ["navigate", "fill", "click", "assert_text", "assert_visible", "assert_absent", "assert_path", "select_option", "phase", "use_actor", "prepare_fixture", "cleanup_fixture", "capture_id", "capture_json", "assert_json", "assert_json_number"]},
                "path": {"type": ["string", "null"]},
                "save_as": {"type": ["string", "null"]},
                "json_pointer": {"type": ["string", "null"]},
                "value_ref": {"type": ["string", "null"]},
                "test_id": {"type": ["string", "null"]},
                "value": {"type": ["string", "null"]},
                "secret_env": {"type": ["string", "null"]},
                "locator": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["role", "name", "label"],
                  "properties": {
                    "role": {"type": ["string", "null"], "enum": ["button", "link", "textbox", "heading", "checkbox", "radio", "combobox", "option", "tab", "menuitem", "alert", "status", "dialog", "region", "switch", "spinbutton", "searchbox", null]},
                    "name": {"type": ["string", "null"]},
                    "label": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "questions": {"type": "array", "description": "At most 20 focused questions, each at most 4000 characters.", "items": {"type": "string"}},
    "assumptions": {"type": "array", "description": "At most 20 assumptions, each at most 4000 characters.", "items": {"type": "string"}}
  }
}
