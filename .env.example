# Local development only. Replace API/worker tokens before using shared machines.
DATABASE_URL=postgres://qa:qa-local-only@127.0.0.1:55439/qa_agent?sslmode=disable
QA_API_TOKEN=local-operator-token-change-me
QA_WORKER_TOKEN=local-worker-token-change-me
QA_ALLOWED_ORIGINS=http://127.0.0.1:4174
QA_API_BASE_URL=http://127.0.0.1:8080
QA_LISTEN_ADDR=127.0.0.1:8080
QA_ARTIFACT_DIR=../artifacts
QA_TEST_EMAIL=demo@example.test
QA_TEST_PASSWORD=pass1234
# Optional: comma-separated OpenAI model IDs you have verified access to.
# Empty keeps AI proposals disabled; deterministic browser runs still work.
QA_OPENAI_MODELS=
# Server-managed credential; BYOK supplies a transient key from the web form.
QA_OPENAI_API_KEY=
