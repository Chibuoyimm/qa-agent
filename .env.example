# Local development only. Replace API/worker tokens before using shared machines.
DATABASE_URL=postgres://qa:qa-local-only@127.0.0.1:55439/qa_agent?sslmode=disable
QA_API_TOKEN=local-operator-token-change-me
QA_WORKER_TOKEN=local-worker-token-change-me
QA_ALLOWED_ORIGINS=http://127.0.0.1:4174
QA_API_BASE_URL=http://127.0.0.1:8080
QA_LISTEN_ADDR=127.0.0.1:8080
QA_ARTIFACT_DIR=../artifacts
QA_TEST_EMAIL=demo@example.test
QA_TEST_PASSWORD=pass1234
# Optional: comma-separated OpenAI model IDs you have verified access to.
# Empty disables this provider’s API-key proposals; ChatGPT plan access is configured below.
QA_OPENAI_MODELS=
# Server-managed credential; BYOK supplies a transient key from the web form.
QA_OPENAI_API_KEY=
# Optional Anthropic/Gemini model allowlists. Use exact IDs with structured-output
# support and access on your key. Empty disables that provider.
QA_ANTHROPIC_MODELS=
QA_ANTHROPIC_API_KEY=
# Needed for a managed Anthropic key that is not scoped to one workspace.
# BYOK uses the optional workspace ID field in the form instead.
QA_ANTHROPIC_WORKSPACE_ID=
QA_GEMINI_MODELS=
QA_GEMINI_API_KEY=

# Optional: ChatGPT plan access for this local/personal pilot, via browser sign-in.
# Requires a loopback QA_LISTEN_ADDR. No API key is needed for this access mode.
QA_CHATGPT_ENABLED=false
# Optional absolute protected directory OUTSIDE the repository. Empty uses the
# operating system user configuration directory under qa-agent/chatgpt.
QA_CHATGPT_STORAGE_DIR=

# Optional: OpenCode Go / Go Plus subscription through a dedicated local runtime.
# Install the pinned binary with node scripts/install-opencode.mjs, then use its
# printed absolute path below. Requires a loopback QA_LISTEN_ADDR.
QA_OPENCODE_ENABLED=false
QA_OPENCODE_BINARY=
# Empty uses the OS user configuration directory under qa-agent/opencode-go.
# If overridden, use an absolute protected directory outside Git repositories.
# Connect the Go key in the web panel; do not put it in this environment file.
QA_OPENCODE_STORAGE_DIR=
